<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#0F0E17">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Game to Patch"
        android:textColor="#F25F4C"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginBottom="16dp"/>

    <Spinner
        android:id="@+id/spinnerGames"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2E2F3E"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnPatch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Patch Selected Game (.dll)"
        android:backgroundTint="#F25F4C"
        android:textColor="#FFFFFE"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvPatchStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Waiting for pairing and selection..."
        android:textColor="#A7A9BE"/>
</LinearLayout>
